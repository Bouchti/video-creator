ANTHROPIC_API_KEY=
TAVILY_API_KEY=
ELEVENLABS_API_KEY=
FAL_API_KEY=
PEXELS_API_KEY=

# Extra free stock sources for --source pexels (all optional).
# Keyless sources (NASA, Internet Archive, Wikimedia Commons) always run.
PIXABAY_API_KEY=
COVERR_API_KEY=
# Priority order of stock sources (comma-separated). Reorder to taste; e.g. put
# archive,wikimedia first to favour on-topic historical footage over generic stock.
STOCK_SOURCES=pexels,pixabay,coverr,nasa,archive,wikimedia

# Local AI video via ComfyUI (--source comfy). No API key needed.
COMFYUI_URL=http://127.0.0.1:8188
COMFY_WORKFLOW=
COMFY_TIMEOUT=3600
