# Claude runs only on your claude.ai subscription through Claude Code (`claude -p`):
# install Claude Code and run `claude` once to log in. No Anthropic API key is used;
# one set in the environment is stripped before every call.
TAVILY_API_KEY=

# Voice: the software creates one narration track after silent video generation.
# Extra keys are tried in order when a key has insufficient credits.
ELEVENLABS_API_KEY=
ELEVENLABS_API_KEY_2=
ELEVENLABS_API_KEY_3=
ELEVENLABS_API_KEY_4=
# When every ElevenLabs key is out of credits, narrate with a free voice instead of stopping the video:
# kokoro = Kokoro-82M, local, offline, on CPU (its own venv, see KOKORO_PYTHON), then Chatterbox, then Edge if
# one fails; chatterbox = Chatterbox TTS then Edge; edge = Microsoft Edge's online voices; none = fail instead.
# VOICE_PROVIDER=kokoro skips ElevenLabs entirely. EDGE_TTS_VOICE overrides the Edge voice.
VOICE_FALLBACK=kokoro
# Kokoro: its interpreter (default %LOCALAPPDATA%/VideoCreator/kokoro/venv), a voice that overrides the style
# mapping (energetic = af_bella, mysterious and storyteller = am_michael), and its speed.
KOKORO_PYTHON=
KOKORO_VOICE=
KOKORO_SPEED=1.0
EDGE_TTS_VOICE=
# Chatterbox: its interpreter (default %LOCALAPPDATA%/VideoCreator/chatterbox/venv), an optional reference clip
# to clone a voice from, and auto/cuda/cpu (auto uses the GPU only when 5 GB are free).
CHATTERBOX_PYTHON=
CHATTERBOX_VOICE=
CHATTERBOX_DEVICE=auto
# Silence between sentences, in seconds, when a sentence has no planned delivery. Long pauses lost
# viewers: the Oct 2026 Shorts were ~19% silence and read at ~2.2 words/s (top Shorts: 3-3.75).
CHATTERBOX_SENTENCE_PAUSE=0.12
# Scales every planned per-sentence pause of the expressive read (1.0 = defaults in agents/voice.py).
PAUSE_SCALE=1.0
# Narration tempo for every voice (1.0 = natural; the old default 0.92 slowed the read).
VOICE_SPEED=1.0

# Stock route (optional; NASA, Internet Archive, and Wikimedia are keyless).
PEXELS_API_KEY=
PIXABAY_API_KEY=
COVERR_API_KEY=
STOCK_SOURCES=pexels,pixabay,coverr,nasa,archive,wikimedia

# ComfyUI used as the Wan fallback for --source local-ai.
COMFYUI_URL=http://127.0.0.1:8188
COMFY_WORKFLOW=
COMFY_TIMEOUT=3600

# Vision check: Claude looks at candidate thumbnails and keeps only stock clips /
# photos that really show what the narration says (a few cents per video).
VISION_CHECK=1
# Model for the vision check; blank uses the pipeline's CLAUDE_MODEL.
VISION_MODEL=
# Wikimedia and Internet Archive reject generic user agents (HTTP 429). Blank uses
# the project URL; set your own "Name/1.0 (contact URL or email)" if you fork.
HTTP_USER_AGENT=
VISION_CHECK=1
VISION_MODEL=

# Durable local AI-video route. MiniMax/Wan are served through compatible local
# ComfyUI endpoints; ComfyUI is transport infrastructure, not a selectable pipeline.
COMFYUI_URL=
COMFYUI_DIR=C:\ComfyUI_windows_portable
# Optional: folder of royalty-free music tracks and their volume under the voice.
MUSIC_DIR=
MUSIC_VOLUME=0.12

# Local AI-video pipeline (--source local-ai; python -m local_video.cli).
# MiniMax H3 (FreeVideo, usually :8190) is tried first; Wan on ComfyUI is the fallback.
# FreeVideo is started automatically from FREEVIDEO_DIR when MiniMax is needed.
FREEVIDEO_DIR=C:\FreeVideo
FREEVIDEO_PORT=8190
FREEVIDEO_STARTUP_TIMEOUT=180
# System RAM (GiB) FreeVideo may keep its weights in; saved to FREEVIDEO_DIR\machine.json.
# Uncapped it holds ~19 GB of 32 GB and starves the rest of the PC. Lower = less RAM, slower clips.
# 0 = no cap (all free RAM).
FREEVIDEO_RAM_GIB=14
# Leave service URLs blank to discover compatible running ComfyUI instances.
MINIMAX_COMFYUI_URL=
WAN_COMFYUI_URL=
LOCAL_VIDEO_OUTPUT_DIR=
LOCAL_VIDEO_RETRY_LIMIT=2
LOCAL_VIDEO_FALLBACK_FAILURES=2
# Share of shots that may be salvaged (a rejected take kept, or a still push-in) before the run
# stops to save GPU hours. 100 = never stop (default): the video is always finished and the salvage
# count is reported as a quality warning.
LOCAL_VIDEO_MAX_DEGRADED_PERCENT=100
# Once every normal take of a shot is rejected, render one more with the camera locked off. 0 = off.
LOCAL_VIDEO_REPAIR_TAKE=1
# 1 = a final creative review reject fails the run. 0 = deliver the video with a quality warning;
# auto-publishing is then held for it unless PUBLISH_FLAGGED_VIDEOS=1.
LOCAL_VIDEO_FINAL_REVIEW_BLOCKS=0
PUBLISH_FLAGGED_VIDEOS=0
# How many times main.py resumes a local-ai project that stopped on a transient fault.
LOCAL_VIDEO_RESUME_ATTEMPTS=2
# Topics tried before the run gives up (a topic whose script cannot be sourced is replaced).
PIPELINE_TOPIC_ATTEMPTS=3
LOCAL_VIDEO_GENERATION_TIMEOUT=3600
LOCAL_VIDEO_POLL_SECONDS=2
LOCAL_VIDEO_UPSCALE_FILTER=lanczos
LOCAL_VIDEO_MIN_FREE_GB=5

# Quality is fail-closed. Set an override to 1 only for deliberate diagnostics.
# Sharpen every clip 2x with Real-ESRGAN on the GPU before assembly (on by default: x2plus). Runs in
# FreeVideo's Python; the model downloads to models/upscale/ on first use. 0 = plain resize; 1 = general-x4v3 (5 MB, fast, smooths
# skin into a painted look); x2plus = the full RealESRGAN_x2plus (64 MB, ~0.3 s per 544x960 frame on an
# RTX 4070, ~10 min per video); x4plus = RealESRGAN_x4plus scaled back to 2x (~4x slower than x2plus).
LOCAL_VIDEO_AI_UPSCALE=x2plus
# Optional path to a downloaded copy of the chosen model's .pth (its file name must match).
LOCAL_VIDEO_UPSCALE_MODEL=
# Optional model just for --source evolution (x2plus | x4plus | general-x4v3 | off); empty = the above.
EVOLUTION_UPSCALE=
# Render the next shot while Claude reviews the current one (cancelled if the review rejects it).
LOCAL_VIDEO_SPECULATIVE=1
# Story-aware start/middle/end frame review by Claude (subscription). 0 disables it.
LOCAL_VIDEO_VISION_QC=1
LOCAL_VIDEO_VISION_MIN_SCORE=7
LOCAL_VIDEO_FINAL_MIN_SCORE=7
LOCAL_VIDEO_ALLOW_QC_SKIP=0
# 1 = keep a take that misses only the soft dimensions (visual_match, continuity, immersion,
# story_progression get one point of relief) while image_quality and anatomy are at threshold
# and nothing fatal was found. A 3s clip of a slow subject scores low on progression even when
# it is a good shot. LOCAL_VIDEO_MAX_DEGRADED_PERCENT is the backstop against a slideshow.
LOCAL_VIDEO_ALLOW_QUALITY_FLOOR=1

# MiniMax H3 / FreeVideo low-VRAM portrait profile.
MINIMAX_WIDTH=544
MINIMAX_HEIGHT=960
MINIMAX_SECONDS=3

# Wan 2.2 TI2V 5B fallback profile.
WAN_WORKFLOW=
WAN_MODEL=Wan2.2-TI2V-5B-Q5_K_M.gguf
WAN_ENCODER=umt5-xxl-encoder-Q4_K_M.gguf
WAN_VAE=wan2.2_vae.safetensors
WAN_WIDTH=480
WAN_HEIGHT=832
WAN_FRAMES=33
WAN_FPS=16
WAN_STEPS=20
WAN_CFG=5

# Optional royalty-free soundtrack. No transition whooshes are added automatically.
MUSIC_DIR=
MUSIC_VOLUME=0.12

# Shared AI routing for scripts, evaluation, set building, and visual review.
SHOWRUNNER_BACKEND=subscription
# When Claude reaches its session limit, continue the same run through logged-in Codex.
SHOWRUNNER_FALLBACK_BACKEND=codex
SHOWRUNNER_CODEX_MODEL=gpt-5.6-sol
# If the selected Codex model is saturated, try these models before consuming Claude quota.
SHOWRUNNER_CODEX_FALLBACK_MODELS=gpt-6.1-sol,gpt-6-sol
SHOWRUNNER_CODEX_EFFORT_CAP=medium
SHOWRUNNER_QUALITY=efficient
# Claude primary-backend settings.
SHOWRUNNER_CLI_MODEL=opus
SHOWRUNNER_CLAUDE_EFFORT_CAP=medium
SHOWRUNNER_MIN_TREND_SCORE=6
# Script draft/evaluate rounds. Documentary drafts converge over several revisions; 3 can strand a
# draft one blocking issue short of PASS and discard the topic. ~25k tokens per round.
SCRIPT_MAX_ATTEMPTS=5
# Topics tried before giving up, when a chosen topic turns out to be mostly unsupported by the
# sources fetched for it. The topic is reconciled with its evidence before scripting, so the
# writer is never asked to tell a story whose premise no source backs.
LEADER_TOPIC_ATTEMPTS=3
# Explicit override only: story subjects are normally consumed after their first generated script.
SHOWRUNNER_ALLOW_REPEATS=0
# When every Max subject is consumed, research/build/review/register a new cutaway set automatically.
SHOWRUNNER_AUTO_BUILD_SETS=1
# kit (default): plan the new story as a storyboard the pre-built kit films (engine/kit; no code is written,
# measured gates only). agent: the old coding-agent set builder (millions of tokens per set).
SHOWRUNNER_SET_MODE=kit
# One advisory AI look at a new kit set's preview (never blocks; the measured gates decide).
KIT_VISION_CHECK=1
# A topic no kit world can film gets a NEW world first (designed as data, every object built and
# tested on its own, then its staging verified), registered and reused: 0 stops such a run instead.
SHOWRUNNER_AUTO_BUILD_WORLDS=1
# Repair rounds per world stage (objects, staging); KIT_WORLD_LOOK=0 skips the vision look at each object.
KIT_WORLD_ROUNDS=4
KIT_WORLD_LOOK=1
# Explainer route (--source explainer): videos per no-hero explainer set before it counts as used.
EXPLAINER_MAX_USES=1
SET_BUILD_ROUNDS=3
# The builder keeps going past SET_BUILD_ROUNDS while a round still improves; this is the minimum cap.
# It is raised automatically until every rejected window has had a repair turn (the budget bounds cost).
SET_BUILD_MAX_ROUNDS=4
# Rounds without a new best draft before the builder stops.
SET_BUILD_PATIENCE=3
# Rejected windows per repair turn while building a set. Small turns finish inside
# SET_BUILDER_CALL_TOKENS; production-film repairs use SCENE_FIX_MAX_WINDOWS below.
SET_FIX_MAX_WINDOWS=3
# Hard ceiling for ONE Claude set-builder agent turn (cache reads included). An agent stopped at the cap
# keeps the files it wrote; the build loop checks and continues from them.
SET_BUILDER_CALL_TOKENS=900000
# Hard token ceiling for one autopilot RUN (kept in output/autopilot/<run>.json, so a resumed run keeps
# counting): a Claude call that would exceed it is refused and the run stops instead of retrying.
# 0 = no ceiling. Covers showrunner, scene review and set building.
CLAUDE_TOKEN_BUDGET=1500000

# Unreal Engine 5 local cinematic renderer. Install UE 5.8 first or point to another compatible build.
UNREAL_EDITOR_CMD=C:\Program Files\Epic Games\UE_5.8\Engine\Binaries\Win64\UnrealEditor-Cmd.exe
UNREAL_PROJECT=unreal\VideoCreatorUE\VideoCreatorUE.uproject
UNREAL_OUTPUT_DIR=output\unreal_projects
UNREAL_WIDTH=1080
UNREAL_HEIGHT=1920
UNREAL_FPS=30
UNREAL_TIMEOUT=7200
UNREAL_MIN_FREE_GB=15
BLENDER_EXE=C:\blender-5.2.3-windows-x64\blender.exe
RENDER_WORKERS=1
SCENE_VALIDATE=1
SCENE_POLICY=stop
SCENE_MIN_SCORE=6
SCENE_WINDOW_SECONDS=3
# Before any production frames, render the exact start/middle/end samples for every final-timing
# window at low resolution and repair until they all pass. Accepted pixel-identical windows are cached.
SCENE_PREFLIGHT=1
SCENE_PREFLIGHT_FIX_ATTEMPTS=3
SCENE_PREFLIGHT_FIX_WINDOWS=6
SCENE_PREFLIGHT_RENDER_PCT=35
SCENE_PREFLIGHT_SAMPLES=8
# Auto-fix rounds per render attempt. Each round is one agentic code-fix session plus a full
# re-render and re-review; normally a safety net because preflight catches story defects first.
SCENE_FIX_ATTEMPTS=2
SCENE_FIX_AGENT_TIMEOUT=600
# 0 = review the whole film, then repair every rejected window in ONE AI turn.
# 1 = stop at the first rejected window, so each AI turn repairs a single window (far more costly).
SCENE_FIX_ABORT_EARLY=0
# Rejected windows detailed in ONE repair turn (worst first); the rest wait for the next round.
SCENE_FIX_MAX_WINDOWS=6
SCENE_REVIEW_BACKEND=
SCENE_REVIEW_CODEX_MODEL=gpt-5.6-sol
SCENE_REVIEW_CODEX_EFFORT_CAP=low
# Empty inherits SHOWRUNNER_CLI_MODEL (opus). Scoring frames 1-10 does not need Opus.
SCENE_REVIEW_CLI_MODEL=sonnet
SCENE_REVIEW_BATCH_SIZE=4
SCENE_REVIEW_WORKERS=1
SCENE_REVIEW_EFFORT=low
SCENE_REVIEW_WIDTH=360
SCENE_REVIEW_JPEG_QUALITY=78
SCENE_ALLOW_QC_SKIP=0
# Autopilot (agents/autopilot.py, used by main.py --source cutaway/explainer)
AUTOPILOT_SCRIPT_ATTEMPTS=3
# Production attempts are bounded; the exact-timing preflight must pass before attempt 1 renders.
AUTOPILOT_MAX_ATTEMPTS=3
AUTOPILOT_MAX_HOURS=6
AUTOPILOT_ON_GIVE_UP=ship
# Successful, validated runs remove reproducible PNG frame caches. Set to 1 for manual --redo work.
AUTOPILOT_KEEP_WORKFILES=0
SET_BUILDER_MODEL=opus
SET_BUILDER_CODEX_MODEL=gpt-5.6-sol
SET_BUILDER_CODEX_EFFORT_CAP=medium
SET_BUILDER_CLAUDE_EFFORT_CAP=medium

# Official publishing adapters. Dry-run package creation is always safe; live
# upload requires both `--publish-live` and PUBLISH_ENABLED=1.
PUBLISH_ENABLED=0
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_PRIVACY=private
YOUTUBE_CATEGORY_ID=27
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
PUBLISH_VIDEO_URL=
META_GRAPH_VERSION=v25.0
INSTAGRAM_PROCESSING_TIMEOUT=900
INSTAGRAM_POLL_SECONDS=10
TIKTOK_ACCESS_TOKEN=
TIKTOK_PRIVACY=SELF_ONLY
TIKTOK_PROCESSING_TIMEOUT=900
TIKTOK_POLL_SECONDS=10

# Photoreal FLUX.1-schnell first frames for fresh openings (first shot and hard cuts), fed to MiniMax.
# KEYFRAME_MODELS_DIR holds checkpoints/<KEYFRAME_CHECKPOINT>; empty = auto-detect a Pinokio drive.
LOCAL_VIDEO_KEYFRAMES=1
KEYFRAME_CHECKPOINT=flux1-schnell-fp8.safetensors
KEYFRAME_MODELS_DIR=

# Default target length in seconds for python main.py when --duration is not given (30-90).
# 62 s: over TikTok's 1-minute Creator Rewards threshold (the queue never fits it below 61 s).
VIDEO_DURATION=62
