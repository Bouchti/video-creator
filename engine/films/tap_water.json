 ],
 "beats": [
  {
   "id": "tap",
   "station": "home",
   "chapter": null,
   "text": "You turn on the tap, and clean water rushes out. Instantly.",
   "hook": "WHERE DOES IT COME FROM?"
  },
  {
   "id": "why",
   "station": "home",
   "chapter": null,
   "text": "But where does it come from? And what pushes it all the way to you?",
   "callouts": [
    {
     "anchor": "home_supply",
     "text": "Supply pipe",
     "at": 0.45
    }
   ]
  },
  {
   "id": "rain",
   "station": "source",
   "chapter": "source",
   "text": "It starts as rain, running off the hills into rivers and lakes."
  },
  {
   "id": "dam",
   "station": "source",
   "chapter": "source",
   "text": "A dam holds it back, in a reservoir.",
   "callouts": [
    {
     "anchor": "dam",
     "text": "Dam",
     "at": 0.15
    },
    {
     "anchor": "reservoir",
     "text": "Reservoir",
     "at": 0.45
    }
   ]
  },
  {
   "id": "intake",
   "station": "source",
   "chapter": "source",
   "text": "Deep below the surface, an intake pipe draws water in, through screens that stop fish and leaves.",
   "callouts": [
    {
     "anchor": "intake_screen",
     "text": "Intake screen",
     "at": 0.45
    }
   ]
  },
  {
   "id": "plant_arrive",
   "station": "plant",
   "chapter": "plant",
   "text": "It flows to a treatment plant, still cloudy with tiny bits of dirt."
  },
  {
   "id": "coagulant",
   "station": "plant",
   "chapter": "plant",
   "title": "MIX",
   "text": "First, a coagulant is mixed in fast. It makes those bits sticky.",
   "callouts": [
    {
     "anchor": "coagulant",
     "text": "Coagulant",
     "at": 0.15
    }
   ]
  },
  {
   "id": "floc",
   "station": "plant",
   "chapter": "plant",
   "title": "CLUMP",
   "text": "Slow paddles stir the water, and the bits clump into fluffy flakes called floc.",
   "callouts": [
    {
     "anchor": "paddle",
     "text": "Paddles",
     "at": 0.1
    },
    {
     "anchor": "floc",
     "text": "Floc",
     "at": 0.7
    }
   ]
  },
  {
   "id": "settle",
   "station": "plant",
   "chapter": "plant",
   "title": "SETTLE",
   "text": "In a long, calm tank, the heavy floc sinks to the bottom.",
   "callouts": [
    {
     "anchor": "sludge",
     "text": "Sludge",
     "at": 0.55
    }
   ]
  },
  {
   "id": "filter",
   "station": "plant",
   "chapter": "plant",
   "title": "FILTER",
   "text": "The clear water on top trickles down through sand and gravel, which trap whatever is left.",
   "callouts": [
    {
     "anchor": "sand",
     "text": "Sand",
     "at": 0.35
    },
    {
     "anchor": "gravel",
     "text": "Gravel",
     "at": 0.5
    }
   ]
  },
  {
   "id": "chlorine",
   "station": "plant",
   "chapter": "plant",
   "title": "DISINFECT",
   "text": "Then a little chlorine kills the germs, and keeps protecting the water all the way to your home.",
   "callouts": [
    {
     "anchor": "chlorine",
     "text": "Chlorine",
     "at": 0.1
    }
   ]
  },
  {
   "id": "clearwell",
   "station": "plant",
   "chapter": "plant",
   "text": "The clean water waits in a covered tank,",
   "callouts": [
    {
     "anchor": "clearwell",
     "text": "Clean water tank",
     "at": 0.1
    }
   ]
  },
  {
   "id": "pumps",
   "station": "plant",
   "chapter": "plant",
   "text": "until powerful pumps push it uphill, into a water tower.",
   "callouts": [
    {
     "anchor": "pump",
     "text": "Pumps",
     "at": 0.1
    }
   ]
  },
  {
   "id": "tower",
   "station": "tower",
   "chapter": "tower",
   "text": "That tower is the secret. Its height pushes water through every pipe in town."
  },
  {
   "id": "pressure",
   "station": "tower",
   "chapter": "tower",
   "text": "Every ten metres of height adds about one bar of pressure.",
   "stat": {
    "display": "10 m = 1 bar",
    "ruler": [
     "tower_base",
     "tower_top"
    ],
    "ruler_m": 30
   }
  },
  {
   "id": "night",
   "station": "tower",
   "chapter": "tower",
   "text": "At night, when nobody is using water, the pumps fill it back up."
  },
  {
   "id": "main",
   "station": "street",
   "chapter": "street",
   "text": "From the tower, water flows into mains buried under your street.",
   "callouts": [
    {
     "anchor": "water_main",
     "text": "Water main",
     "at": 0.45
    }
   ]
  },
  {
   "id": "sewer",
   "station": "street",
   "chapter": "street",
   "text": "Unlike the sewer below them, these pipes are always full, and always under pressure.",
   "callouts": [
    {
     "anchor": "sewer_main",
     "text": "Sewer",
     "at": 0.12
    },
    {
     "anchor": "water_main",
     "text": "Full and pressurised",
     "at": 0.5
    }
   ]
  },
  {
   "id": "service",
   "station": "street",
   "chapter": "street",
   "text": "A smaller pipe branches off to your house,",
   "callouts": [
    {
     "anchor": "service_pipe",
     "text": "Service pipe",
     "at": 0.2
    }
   ]
  },
  {
   "id": "meter",
   "station": "street",
   "chapter": "street",
   "text": "through the meter that counts every litre,",
   "callouts": [
    {
     "anchor": "meter",
     "text": "Water meter",
     "at": 0.1
    }
   ]
  },
  {
   "id": "upstairs",
   "station": "home",
   "chapter": "home",
   "text": "and up inside the walls to every tap, even upstairs."
  },
  {
   "id": "glass",
   "station": "home",
   "chapter": "home",
   "text": "All that work, for one glass of water."
  },
  {
   "id": "question",
   "station": "home",
   "chapter": "home",
   "text": "So, tap or bottled: which one do you drink?",
   "question": "TAP OR BOTTLED?"
  }
 ],
